# ---------------------------------------------------------------------------
# AMR Free Roof Inspection Funnel — environment variables
# Copy to .env.local for local dev, and set the same values in Vercel.
# .env*.local is gitignored — never commit real values.
# ---------------------------------------------------------------------------

# Option A (recommended): GoHighLevel Inbound Webhook URL.
# GHL → Automation → Workflows → new workflow → trigger "Inbound Webhook" → copy URL.
GHL_WEBHOOK_URL=

# Meta (Facebook) Pixel ID — exposed to the browser (NEXT_PUBLIC_), not a secret.
NEXT_PUBLIC_META_PIXEL_ID=1326142483056853

# TikTok Pixel ID — exposed to the browser (NEXT_PUBLIC_), not a secret.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=D9R4KTRC77U6RO6J2VE0

# Google Ads (gtag.js, direct — no GTM). Exposed to the browser, not secrets.
# Get both from Google Ads → Goals → Conversions → your conversion action's
# "Tag setup" (ID looks like AW-123456789, label is the string after the slash).
# The tag doesn't load and the conversion never fires until BOTH are set.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-17577934623
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=gRiNCOHt5vkbEJ_-571B

# Meta Conversions API (server-only — never NEXT_PUBLIC_). Leave the token unset
# to disable the server-side events; GoHighLevel delivery is unaffected.
META_CAPI_ACCESS_TOKEN=
META_DATASET_ID=
# Optional: shows events under Test Events in Events Manager while validating.
META_TEST_EVENT_CODE=

# Optional: canonical site URL used for metadata (e.g. https://inspect.americanmasterroofing.com).
# On Vercel this falls back to VERCEL_URL automatically if unset.
# NEXT_PUBLIC_SITE_URL=
